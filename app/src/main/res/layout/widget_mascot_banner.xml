<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mascot_banner_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Sfondo card con trasparenza e colore dinamico -->
    <ImageView
        android:id="@+id/mascot_banner_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_card_rounded_bg"
        android:scaleType="fitXY"
        android:contentDescription="Sfondo widget banner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Mascot Duolingo a sinistra -->
        <ImageView
            android:id="@+id/mascot_banner_image"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_mascot_happy"
            android:scaleType="fitCenter"
            android:contentDescription="Mascot studio banner" />

        <!-- Colonna Dettagli a destra -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Riga superiore: Icona fiamma + serie + badge compiti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/mascot_banner_streak_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_flame_badge"
                    android:contentDescription="Icona serie" />

                <TextView
                    android:id="@+id/mascot_banner_streak_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mascot_banner_streak_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="giorni"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/mascot_banner_progress_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Titolo di stato / urgenza Duolingo -->
            <TextView
                android:id="@+id/mascot_banner_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Obiettivo centrato!"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Barra di progresso compiti -->
            <ProgressBar
                android:id="@+id/mascot_banner_progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="3dp"
                android:max="100"
                android:progress="0" />

            <!-- Sottotesto con dettaglio orario / motivazione -->
            <TextView
                android:id="@+id/mascot_banner_sub_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Serie protetta per oggi"
                android:textColor="#888888"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
