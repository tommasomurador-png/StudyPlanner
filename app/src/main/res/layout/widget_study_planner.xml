<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: App Title + Streak Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Study Planner Icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Study Planner"
            android:textColor="#24382C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0 gg"
            android:textColor="#C85A17"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Today's Tasks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_tasks_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMPITI DI OGGI"
            android:textColor="#7A786E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tasks_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nessun compito"
            android:textColor="#1A2D24"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Action: Launch Focus Pomodoro -->
    <LinearLayout
        android:id="@+id/widget_btn_pomodoro"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍅 Avvia Pomodoro"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
