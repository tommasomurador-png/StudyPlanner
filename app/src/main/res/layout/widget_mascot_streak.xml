<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mascot_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background card con trasparenza e tema dinamico -->
    <ImageView
        android:id="@+id/mascot_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_card_rounded_bg"
        android:scaleType="fitXY"
        android:contentDescription="Sfondo widget mascot" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Header: Badge Fiamma + Numero Serie -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/mascot_streak_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_flame_badge"
                android:contentDescription="Icona serie" />

            <TextView
                android:id="@+id/mascot_streak_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mascot_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="giorni"
                android:textColor="#A0A0A0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Immagine Mascot Reattiva -->
        <ImageView
            android:id="@+id/mascot_image"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:src="@drawable/ic_mascot_happy"
            android:scaleType="fitCenter"
            android:layout_marginBottom="6dp"
            android:contentDescription="Mascot studio" />

        <!-- Messaggio di stato / motivazione -->
        <TextView
            android:id="@+id/mascot_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Oggi completato!"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <!-- Sottotesto task rimanenti o consiglio -->
        <TextView
            android:id="@+id/mascot_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:text="Serie al sicuro"
            android:textColor="#888888"
            android:textSize="11sp"
            android:maxLines="1" />

    </LinearLayout>
</FrameLayout>
