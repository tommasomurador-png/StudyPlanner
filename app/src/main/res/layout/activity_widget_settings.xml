<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_settings_dialog">

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Impostazioni widget"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalizza il widget per la schermata home"
            android:textColor="#9E9EA6"
            android:textSize="12.5sp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="18dp" />

        <!-- Live Widget Preview with Wallpaper Gradient -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@drawable/bg_preview_container"
            android:layout_marginBottom="22dp">

            <FrameLayout
                android:id="@+id/widget_preview_card"
                android:layout_width="match_parent"
                android:layout_height="136dp">

                <!-- Dynamic Preview Background (tints & transparent alpha) -->
                <ImageView
                    android:id="@+id/widget_preview_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_card_rounded_bg"
                    android:scaleType="fitXY"
                    android:contentDescription="Anteprima Sfondo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp">

                    <!-- Preview Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/widget_preview_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Da fare oggi"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/widget_preview_add"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_widget_add"
                            android:contentDescription="Aggiungi" />
                    </LinearLayout>

                    <!-- Preview Item 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <ImageView
                            android:id="@+id/widget_preview_chk1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_widget_check_empty"
                            android:contentDescription="Da fare" />

                        <TextView
                            android:id="@+id/widget_preview_item1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="[Matematica] Esercizi pag. 140"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Preview Item 2 (Completed) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <ImageView
                            android:id="@+id/widget_preview_chk2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_widget_check_done"
                            android:contentDescription="Completato" />

                        <TextView
                            android:id="@+id/widget_preview_item2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="[Filosofia] Ripasso Platone"
                            android:textColor="#888888"
                            android:textSize="12.5sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Section: Theme -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMA WIDGET"
            android:textColor="#9E9EA6"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="9dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:id="@+id/btn_theme_dark"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_active"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_theme_dark"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_moon"
                    android:contentDescription="Icona Scuro" />

                <TextView
                    android:id="@+id/text_theme_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scuro"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/btn_theme_light"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/icon_theme_light"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_sun"
                    android:contentDescription="Icona Chiaro" />

                <TextView
                    android:id="@+id/text_theme_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chiaro"
                    android:textColor="#9E9EA6"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Transparency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRASPARENZA SFONDO"
                android:textColor="#9E9EA6"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/text_transparency_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#409CFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_transparency"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekbar_transparency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginBottom="26dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Annulla"
                android:textColor="#9E9EA6"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_inactive"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Salva"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_save_btn"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
